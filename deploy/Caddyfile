# Caddy in front of the Airspace Monitor server (server/README.md, "Moving to a VPS").
#
# 1. Point your domain's DNS A/AAAA record at the VPS.
# 2. Replace airspace.example.com below with that domain. Use the same origin as
#    PUBLIC_URL in .env and as the redirect URL registered with VATSIM Connect
#    (https://<domain>/auth/callback).
# 3. Open ports 80 and 443 on the firewall, and keep 3000 closed: the server listens on
#    127.0.0.1 only (HOST in .env).
# 4. Install as /etc/caddy/Caddyfile and run `sudo systemctl reload caddy`.
#
# Caddy gets and renews the HTTPS certificate by itself, redirects HTTP to HTTPS, and passes
# the original Host header and X-Forwarded-For to the server. The server already sends the
# CSP and Strict-Transport-Security headers, so they aren't repeated here.

airspace.example.com {
	encode zstd gzip

	header {
		-Server
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# /healthz answers "ok" without a sign-in, for uptime checks.
	reverse_proxy 127.0.0.1:3000 {
		# Sign-in is a redirect to VATSIM and back, so a slow reply means a hung server.
		transport http {
			response_header_timeout 30s
		}
	}

	# Access logs hold IP addresses and paths; they are kept for 30 days (720h), as the
	# privacy policy says. Change both together.
	log {
		output file /var/log/caddy/airspace-monitor.log {
			roll_size 10mb
			roll_keep 5
			roll_keep_for 720h
		}
	}
}
