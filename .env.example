# Settings for `npm run server` (see server/README.md). Copy to .env, which is git-ignored.

# Port the server listens on.
PORT=3000

# The origin people open the site at: exactly what's in the address bar, no path. VATSIM
# Connect sends people back to PUBLIC_URL/auth/callback, so that URL must be registered as
# the redirect URL of your VATSIM Connect client. Examples:
#   http://localhost:3000
#   https://amuck-yesterday-cilantro.ngrok-free.dev
PUBLIC_URL=http://localhost:3000

# VATSIM Connect. The sandbox is https://auth-dev.vatsim.net; production is
# https://auth.vatsim.net (the default if this is left out).
VATSIM_AUTH_BASE=https://auth-dev.vatsim.net
VATSIM_CLIENT_ID=
VATSIM_CLIENT_SECRET=

# Signs session cookies. Random, 32+ characters, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Admins besides the built-in 1935951, comma-separated. They can open every page and can't
# be removed on the admin page. Sandbox accounts are 10000001-10000011, so add one of them
# to test the admin page against auth-dev.
SUPERADMIN_CIDS=10000010

# How long a sign-in lasts, in seconds (default 7 days).
# SESSION_TTL_S=604800

# Where the site builds (live/, dev/) and the access lists (access.json) are kept, relative
# to the repo. Defaults: site, data.
# SITE_DIR=site
# DATA_DIR=data
